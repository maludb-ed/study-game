# /etc/systemd/system/studygame-records-mcp.service (Ubuntu 24.04)
[Unit]
Description=Cert Arena record-memory MCP server (read-only)
After=network.target postgresql.service

[Service]
User=studygame
WorkingDirectory=/var/www/studygame
EnvironmentFile=/var/www/studygame/config/services.env
ExecStart=/var/www/studygame/services/.venv/bin/python services/records_mcp.py
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
